# Shelterflex web — environment variables
#
# Copy to .env.local for local development. On Vercel, set these under
# Project Settings → Environment Variables for Production and Preview, then
# redeploy: NEXT_PUBLIC_* values are inlined at build time.
#
# Anything prefixed NEXT_PUBLIC_ ships in the browser bundle and is readable by
# anyone. Never put secrets in a NEXT_PUBLIC_ variable.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# [REQUIRED in production] Absolute URL of the Shelterflex API, no trailing
# slash. Read by the server at runtime, injected into the page for the client,
# and added to the CSP connect-src. Falls back to http://localhost:4000 in dev.
BACKEND_URL=https://shelterflex.zplague.xyz

# [RECOMMENDED] Same origin as BACKEND_URL — bare domain, no /api suffix.
# Used by the whistleblower pages and to derive the notifications WebSocket
# (wss://<host>/ws/notifications).
NEXT_PUBLIC_API_URL=https://shelterflex.zplague.xyz

# [OPTIONAL] Base URL for listing photos, served by the backend's /media route.
# Read at build time (lib/media.ts, next.config image remotePatterns, CSP).
# Defaults to https://shelterflex.zplague.xyz/media when unset.
NEXT_PUBLIC_MEDIA_BASE_URL=https://shelterflex.zplague.xyz/media

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# [RECOMMENDED] Canonical origin of this deployment, used for SEO canonical
# links and Open Graph URLs. Use the deployment's own domain, e.g.
#   https://shelterflex.vercel.app  or  https://shelterflex-demo.vercel.app
NEXT_PUBLIC_SITE_URL=https://shelterflex.vercel.app

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Sentry DSN for client error reporting. Disabled when unset.
NEXT_PUBLIC_SENTRY_DSN=

# Endpoint that receives client error reports. Disabled when unset.
NEXT_PUBLIC_ERROR_REPORTING_URL=

# Deal ID shown on the demo lease pages. Defaults to a placeholder UUID.
NEXT_PUBLIC_TENANT_DEAL_ID=

# Leave unset: the live transaction/staking/system hooks expect WebSocket
# endpoints the backend does not expose yet (only /ws/notifications exists).
# NEXT_PUBLIC_WS_URL=

# Do not set: a NEXT_PUBLIC_ value is public, so this cannot hold a real admin
# secret. /admin/health is refused without it, which is the safe default.
# NEXT_PUBLIC_ADMIN_SECRET=
